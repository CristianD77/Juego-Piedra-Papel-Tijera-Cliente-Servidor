<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consultar resultados"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3B8BD4"
        android:layout_marginBottom="30dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa tu correo electrónico:"
        android:textSize="15sp"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ejemplo@gmail.com"
        android:inputType="textEmailAddress"
        android:textSize="15sp"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvEstadoCorreo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnEnviarCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enviar resultados"
        android:backgroundTint="#3B8BD4"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnVolverMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Volver al menú"
        android:backgroundTint="#888888"/>

</LinearLayout>